# Relational Database Connection
# Default SQLite embedded:
DATABASE_URL=sqlite:///./data/fraud_detection.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://fraud_user:fraud_pass@localhost:5432/fraud_db

# Streaming Configuration
# Set to 'true' to use production Apache Kafka, or 'false' to use the zero-dependency in-memory simulator
USE_KAFKA=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions_stream
STREAM_DELAY=0.3

# Fraud Model Decision Threshold
FRAUD_THRESHOLD=0.30

# Streamlit App Port
PORT=8501
